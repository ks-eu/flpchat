    "database::users::removeself_user_tests::remove_private_recipient": {
      "id": "remove-private-recipient",
      "component": "removeself-user",
      "suite": "regular",
      "alias": "Cascades through the recipient ID",
      "input": "R plus private messages 22 (8 to 7) and 23 (8 to 9), remove (\"target\", \"target-hash\").",
      "expected": "Success(7); private message 22 is gone. Message 23 survives."
    },
    "database::users::removeself_user_tests::remove_db_error": {
      "id": "remove-db-error",
      "component": "removeself-user",
      "suite": "regular",
