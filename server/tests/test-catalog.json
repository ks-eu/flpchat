{
  "components": {
    "create-pool": {
      "title": "create_pool",
      "inputs": "DATABASE_URL (environment)"
    },
    "credential-lengths": {
      "title": "invalid_credential_lengths",
      "inputs": "username: &str, password: &str, max_len_username: usize, max_len_password: usize"
    },
    "verify-password": {
      "title": "verify_password",
      "inputs": "password: &str, hashed_password: &str"
    },
    "hash-password": {
      "title": "hash_password",
      "inputs": "password: &str, hash_permit: Arc<Semaphore>"
    },
    "user-handler-run": {
      "title": "UserHandler::run",
      "inputs": "self"
    },
    "insert-user": {
      "title": "UserHandler::insert_user",
      "inputs": "&self, username: &str, hashed_password: &str"
    },
    "removeself-user": {
      "title": "UserHandler::removeself_user",
      "inputs": "&self, username: &str, hashed_password: &str"
    },
    "verify-credentials": {
      "title": "UserHandler::verify_credentials",
      "inputs": "&self, username: &str, password: &str"
    },
    "lookup-password": {
      "title": "UserHandler::get_hashed_password",
      "inputs": "&self, username: &str"
    },
    "handle-register": {
      "title": "handle_register",
      "inputs": "request: Register, user_tx: Sender<UserRequest>, hash_permit: Arc<Semaphore>, sink: FlpcSink, server_token: &str, max_len_username: usize, max_len_password: usize"
    },
    "check-token": {
      "title": "check_token",
      "inputs": "request: &Register, server_token: &str"
    }
  },
  "cases": {
    "database::create_pool_tests::create_pool_connects_to_postgres": {
      "id": "pool-connect",
      "component": "create-pool",
      "suite": "regular",
      "alias": "Connects to the test database",
      "input": "Runner-provided DATABASE_URL and its ready PostgreSQL instance",
      "expected": "Ok(pool) and SELECT 1 returns 1. Close the pool."
    },
